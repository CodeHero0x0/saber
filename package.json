{
  "name": "@codehero0x0/saber",
  "version": "0.2.2",
  "description": "Team AI skills and knowledge assets for nested business repositories.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeHero0x0/saber.git"
  },
  "homepage": "https://github.com/CodeHero0x0/saber#readme",
  "bugs": {
    "url": "https://github.com/CodeHero0x0/saber/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "saber": "./dist/main.js"
  },
  "files": [
    "dist/",
    "saber.yaml",
    "skills/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run check && npm test && npm run build",
    "saber": "tsx src/main.ts",
    "build:binary": "node scripts/build-sea.mjs",
    "smoke:binary": "node scripts/smoke-sea.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
